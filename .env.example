# Copy to .env for local development (never commit .env).
# On Render, set these under Environment for the web service.

# --- Core -------------------------------------------------------------------
DEBUG=False
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
# Comma-separated. RENDER_EXTERNAL_HOSTNAME is added automatically on Render.
ALLOWED_HOSTS=gas-delivery-backend-ekqu.onrender.com
# Optional: move the Django admin to a less guessable path (must end with /).
ADMIN_URL=admin/

# --- Database / Redis ---------------------------------------------------------
DATABASE_URL=postgres://user:password@host:5432/dbname
DB_SSL_REQUIRE=False
# Needed for WebSocket notifications with more than one server process.
REDIS_URL=redis://localhost:6379/0

# --- CORS / CSRF (comma-separated full origins) ------------------------------
# The admin dashboard's URL(s). The mobile app does not need CORS.
CORS_ALLOWED_ORIGINS=https://your-admin-dashboard.vercel.app
# Optional regexes, e.g. for Vercel preview deployments.
CORS_ALLOWED_ORIGIN_REGEXES=
CSRF_TRUSTED_ORIGINS=

# --- Auth -------------------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30
# Set to the number of proxies in front of the app if you know it (for throttling).
NUM_PROXIES=

# --- Initial admin account (created by `python manage.py create_admin`) ------
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# --- Email (Resend) -----------------------------------------------------------
# Without a key, emails are printed to the console.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com

# --- M-Pesa (Daraja) ----------------------------------------------------------
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Sandbox defaults to Safaricom's public test shortcode/passkey if left empty.
MPESA_SHORTCODE=
MPESA_PASSKEY=
# CustomerPayBillOnline (paybill) or CustomerBuyGoodsOnline (till).
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# For Buy Goods: the till number. Defaults to MPESA_SHORTCODE.
MPESA_PARTY_B=
# Long random string. If set, MPESA_CALLBACK_URL must end with /<token>/.
MPESA_CALLBACK_TOKEN=
MPESA_CALLBACK_URL=https://gas-delivery-backend-ekqu.onrender.com/api/payments/mpesa-callback/<token>/
